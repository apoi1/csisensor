# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash: change to 8MB/16MB if your board has a bigger flash chip
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 1 kHz FreeRTOS tick → precise pdMS_TO_TICKS() pacing
CONFIG_FREERTOS_HZ=1000

# THE core feature: compile CSI capture support into the Wi-Fi driver.
# Without this, esp_wifi_set_csi(true) fails with ESP_FAIL and the
# firmware aborts in a boot loop ("CSI not enabled in menuconfig!").
CONFIG_ESP_WIFI_CSI_ENABLED=y
